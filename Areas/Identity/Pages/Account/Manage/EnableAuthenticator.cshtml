@page
@model twoSaaSCore.Areas.Identity.Pages.Account.Manage.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Enable Authenticator";
}
<h1 class="h5 mb-3">@ViewData["Title"]</h1>

<p>Scan this QR code with your authenticator app (Microsoft / Google Authenticator, 1Password, Authy, etc.).</p>

@if (!string.IsNullOrEmpty(Model.QrCodePngBase64))
{
    <div class="mb-3">
        <img alt="Authenticator QR"
             style="width:200px;height:200px;border:1px solid #ccc;padding:4px;background:#fff;"
             src="data:image/png;base64,@Model.QrCodePngBase64" />
    </div>
}

<div class="mb-3">
    <strong>Manual key:</strong>
    <code>@Model.SharedKey</code>
    <div class="text-muted small">If scanning fails, enter this key manually (Time?based, 6 digits).</div>
</div>

<div class="mb-3">
    <strong>URI (for troubleshooting):</strong>
    <code class="small text-break">@Model.AuthenticatorUri</code>
</div>

<form method="post" class="mt-3">
    <div class="mb-2">
        <label asp-for="Input.Code" class="form-label"></label>
        <input asp-for="Input.Code" class="form-control form-control-sm" autocomplete="one-time-code" />
        <span asp-validation-for="Input.Code" class="text-danger small"></span>
    </div>
    <button class="btn btn-sm btn-primary">Verify &amp; Enable</button>
    <a asp-page="./TwoFactorAuthentication" class="btn btn-sm btn-outline-secondary ms-1">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}