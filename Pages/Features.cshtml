@page
@model FeaturesModel
@{
    ViewData["Title"] = "Features";
    Layout = "_Layout.Landing";
}

<nav class="vr-landing-nav">
    <a class="brand" href="/">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
        VaultRoom
    </a>
    <div class="nav-links">
        <a asp-page="/Features">Features</a>
        <a asp-page="/Pricing">Pricing</a>
        <a asp-page="/Security">Security</a>
        <a asp-page="/UseCases">Use Cases</a>
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Files/Index" class="btn-landing-primary" style="padding:.45rem 1.2rem;font-size:.85rem;">Dashboard</a>
        }
        else
        {
            <a href="#" onclick="openLoginModal();return false;">Sign in</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-landing-primary" style="padding:.45rem 1.2rem;font-size:.85rem;">Start Free</a>
        }
    </div>
</nav>

<section class="vr-section">
    <div class="vr-section-header">
        <span class="eyebrow">Features</span>
        <h2>Everything you need to run a secure deal room</h2>
        <p>No feature paywalls. Every plan gets the full platform.</p>
    </div>

    <!-- Document Management -->
    <div class="vr-feature-category">
        <h3>📁 Document Management</h3>
        <div class="vr-features" style="padding:1rem 0 2rem;">
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                </div>
                <h3>Unlimited Nested Folders</h3>
                <p>Create any folder structure you need — unlimited depth. Mirrors your existing file organization so teams onboard instantly.</p>
            </div>
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
                </div>
                <h3>Large File Upload</h3>
                <p>Upload files up to 100 GB with parallel block transfers, real-time progress, MD5 integrity checks, and cancellation support.</p>
            </div>
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <h3>Multi-Format Viewing</h3>
                <p>View PDFs, Word documents, and Excel spreadsheets directly in the browser — no downloads required, no plugins.</p>
            </div>
        </div>
    </div>

    <!-- Security & Access -->
    <div class="vr-feature-category">
        <h3>🔒 Security &amp; Access Control</h3>
        <div class="vr-features" style="padding:1rem 0 2rem;">
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3>AES-256 Encryption</h3>
                <p>Every file encrypted at rest with AES-256 and in transit with TLS 1.3. Your data is protected at every layer.</p>
            </div>
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h3>Multi-Factor Authentication</h3>
                <p>Authenticator app and SMS-based MFA. Optionally enforce MFA for all users across your organization.</p>
            </div>
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </div>
                <h3>Dynamic Watermarks</h3>
                <p>Every viewed document is watermarked with the viewer's user ID, tenant, and timestamp — creating forensic traceability.</p>
            </div>
        </div>
    </div>

    <!-- Organization & Admin -->
    <div class="vr-feature-category">
        <h3>🏢 Organization &amp; Administration</h3>
        <div class="vr-features" style="padding:1rem 0 2rem;">
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>Multi-Tenant Isolation</h3>
                <p>Every organization gets a fully isolated tenant with its own subdomain, data partition, and user management.</p>
            </div>
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h3>Room-Level NDA</h3>
                <p>Attach a custom NDA to any room. Viewers must acknowledge the agreement before accessing documents.</p>
            </div>
            <div class="vr-feature-card">
                <div class="icon">
                    <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </div>
                <h3>Immutable Audit Ledger</h3>
                <p>Every upload, download, view, and deletion is recorded in a tamper-proof SQL audit log — exportable to CSV or JSON.</p>
            </div>
        </div>
    </div>
</section>

<div class="vr-cta-banner">
    <h2>See it in action</h2>
    <p>Create a free room and upload your first document in under 2 minutes.</p>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn-cta">Start Free →</a>
</div>

<footer class="vr-landing-footer">
    <div class="footer-links">
        <a asp-page="/Features">Features</a>
        <a asp-page="/Pricing">Pricing</a>
        <a asp-page="/Security">Security</a>
        <a asp-page="/UseCases">Use Cases</a>
        <a asp-page="/Privacy">Privacy</a>
    </div>
    &copy; 2025 VaultRoom. All rights reserved.
</footer>
