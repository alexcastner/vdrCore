@page "/Files/ViewPdf"
@using System.Text.Json
@model twoSaaSCore.Pages.Files.ViewPdfModel
@{
    ViewData["Title"] = "View PDF";
}
<h3 class="mb-3">@Model.FileName</h3>

<!-- Optional watermark container -->
<div id="watermark"
     style="pointer-events:none;position:fixed;inset:0;display:flex;justify-content:center;align-items:center;opacity:.08;font-size:8rem;font-weight:700;transform:rotate(-25deg);z-index:5;user-select:none;">
    CONFIDENTIAL
</div>

<div id="pdfToolbar" class="btn-toolbar mb-2 gap-2" role="toolbar">
        <div class="btn-group btn-group-sm">
        <button id="btnPrev" class="btn btn-outline-secondary" disabled>Prev</button>
        <button id="btnNext" class="btn btn-outline-secondary" disabled>Next</button>
    </div>
    <div class="btn-group btn-group-sm">
        <span class="btn btn-light disabled">
            Page <span id="pageNum">0</span> / <span id="pageCount">0</span>
        </span>
    </div>
    <div class="btn-group btn-group-sm">
        <button id="btnZoomOut" class="btn btn-outline-secondary" disabled>-</button>
        <button id="btnZoomIn" class="btn btn-outline-secondary" disabled>+</button>
        <button id="btnFitWidth" class="btn btn-outline-secondary" disabled>Fit Width</button>
    </div>
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-secondary" href="javascript:history.back()">Close</a>
    </div>
</div>

<div id="pdfContainer" class="border rounded p-1"
     style="position:relative; overflow:auto; height: calc(100vh - 240px); background:#2b2b2b;">
    <canvas id="pdfCanvas"
            style="display:block; margin:0 auto; background:#fff; box-shadow:0 0 6px rgba(0,0,0,.4); position:relative;"></canvas>
</div>


@section Scripts {
    <!-- ES Module usage of pdf.js v5.4.0 -->
    <script type="module">
        import pdfjsDist from 'https://cdn.jsdelivr.net/npm/pdfjs-dist@5.4.149/+esm'
        pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdn.jsdelivr.net/npm/pdfjs-dist@5.4.149/build/pdf.worker.mjs`;

        // Import our viewer module
        import { initPdfViewer } from "/js/pdf-viewer.js";

        initPdfViewer({ url: "@Model.PdfSourceUrl" }, pdfjsLib);

    </script>
}