@page "/Files/ViewDocument"
@model twoSaaSCore.Pages.Files.ViewDocumentModel
@{
    ViewData["Title"] = "View Document";
    var ext = System.IO.Path.GetExtension(Model.FileName).ToLowerInvariant().TrimStart('.');
    var badgeClass = ext switch { "pdf" => "vr-badge-pdf", "xlsx" or "xls" => "vr-badge-xlsx", "docx" or "doc" => "vr-badge-docx", _ => "vr-badge-file" };
}

<div class="vr-viewer">
    <div class="vr-viewer-header">
        <div class="vr-viewer-title">
            <span class="@badgeClass">@ext</span>
            <h1>@Model.FileName</h1>
        </div>
        @if (!Model.ShowDownloadFallback)
        {
        <div class="vr-viewer-toolbar" id="pdfToolbar">
            <div class="vr-toolbar-group">
                <button id="btnPrev" class="vr-toolbar-btn" disabled title="Previous page (?)">
                    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <span class="vr-toolbar-label">
                    <span id="pageNum">0</span> / <span id="pageCount">0</span>
                </span>
                <button id="btnNext" class="vr-toolbar-btn" disabled title="Next page (?)">
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
            <div class="vr-toolbar-divider"></div>
            <div class="vr-toolbar-group">
                <button id="btnZoomOut" class="vr-toolbar-btn" disabled title="Zoom out (?)">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                </button>
                <span id="zoomLevel" class="vr-toolbar-label">100%</span>
                <button id="btnZoomIn" class="vr-toolbar-btn" disabled title="Zoom in (+)">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                </button>
                <button id="btnFitWidth" class="vr-toolbar-btn" disabled title="Fit width">
                    <svg viewBox="0 0 24 24"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                </button>
            </div>
            <div class="vr-toolbar-divider"></div>
            <a class="vr-toolbar-btn" href="javascript:window.close()" title="Close viewer">
                <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </a>
        </div>
        }
    </div>

    @if (Model.ShowDownloadFallback)
    {
    <div class="vr-download-fallback">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <h2>Preview not available</h2>
        <p>This document cannot be previewed in the browser. You can download it instead.</p>
        <a class="vr-download-btn"
           asp-page="/Files/DownloadFile"
           asp-route-roomId="@Model.RoomId"
           asp-route-fileId="@Model.FileId">
            Download @Model.FileName
        </a>
    </div>
    }
    else
    {
    <div class="vr-watermark">@Model.WatermarkText</div>

    <div id="pdfContainer" class="vr-viewer-canvas">
        <canvas id="pdfCanvas"></canvas>
    </div>
    }
</div>

<style>
    .vr-pdf-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .75rem;
        padding: 3rem;
        color: var(--vr-text-muted);
        font-size: .9rem;
    }
    .vr-pdf-spinner {
        width: 32px; height: 32px;
        border: 3px solid var(--vr-border);
        border-top-color: var(--vr-accent);
        border-radius: 50%;
        animation: vr-spin .7s linear infinite;
    }
    @@keyframes vr-spin { to { transform: rotate(360deg); } }
    .vr-pdf-error {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: 3rem;
        color: var(--vr-danger);
        text-align: center;
    }
    .vr-pdf-error p { margin: 0; font-size: .9rem; }
    .vr-download-fallback {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 4rem 2rem;
        text-align: center;
        color: var(--vr-text-muted);
    }
    .vr-download-fallback h2 {
        margin: 0;
        font-size: 1.25rem;
        color: var(--vr-text);
    }
    .vr-download-fallback p {
        margin: 0;
        font-size: .9rem;
        max-width: 28rem;
    }
    .vr-download-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .625rem 1.25rem;
        background: var(--vr-accent);
        color: #fff;
        border-radius: .375rem;
        text-decoration: none;
        font-weight: 500;
        font-size: .9rem;
        transition: background .15s;
    }
    .vr-download-btn:hover {
        background: var(--vr-accent-hover, var(--vr-accent));
        color: #fff;
    }
</style>

@if (!Model.ShowDownloadFallback)
{
@section Scripts {
    <script type="module">
        import { initPdfViewer } from "/js/pdf-viewer.js";
        initPdfViewer({ url: @Json.Serialize(Model.PdfSourceUrl) });
    </script>
}
}