<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VaultRoom</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/twoSaaSCore.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuth = User?.Identity?.IsAuthenticated ?? false;
        var tenantId = User?.FindFirst("tenant_id")?.Value;
        var userName = User?.Identity?.Name ?? "";
        var initials = userName.Length >= 2
            ? $"{userName[0]}{userName[userName.LastIndexOf(' ') + 1]}".ToUpper()
            : userName.Length > 0 ? userName[..1].ToUpper() : "?";
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    }

    <div class="vr-shell">
        <!-- Sidebar backdrop (mobile) -->
        <div class="vr-sidebar-backdrop" id="sidebarBackdrop" onclick="document.getElementById('sidebar').classList.remove('open');this.classList.remove('show');"></div>

        <!-- Sidebar -->
        <aside class="vr-sidebar" id="sidebar">
            <a class="vr-sidebar-brand" asp-area="" asp-page="/Index">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
                VaultRoom
            </a>

            <div class="vr-sidebar-section">
                <div class="vr-sidebar-label">Workspace</div>
                <ul class="vr-sidebar-nav">
                    <li>
                        <a asp-area="" asp-page="/Files/Index" class="@(currentPage.StartsWith("/Files") ? "active" : "")">
                            <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                            Data Rooms
                        </a>
                    </li>
                </ul>
            </div>

            @if (isAuth)
            {
                <div class="vr-sidebar-section">
                    <div class="vr-sidebar-label">Account</div>
                    <ul class="vr-sidebar-nav">
                        <li>
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="@(currentPage.Contains("/Manage/") ? "active" : "")">
                                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Profile
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-page="/Privacy" class="@(currentPage == "/Privacy" ? "active" : "")">
                                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                Privacy
                            </a>
                        </li>
                    </ul>
                </div>
            }

            <div class="vr-sidebar-footer">
                @if (isAuth)
                {
                    <div class="vr-sidebar-user">
                        <span class="vr-avatar">@initials</span>
                        <div class="vr-sidebar-user-info">
                            <span class="vr-sidebar-user-name">@userName</span>
                            @if (!string.IsNullOrEmpty(tenantId))
                            {
                                <span class="vr-sidebar-user-tenant font-mono">@tenantId[..Math.Min(8, tenantId.Length)]…</span>
                            }
                        </div>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                        <button type="submit" class="vr-btn-signout">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <div class="d-grid gap-2">
                        <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-area="Identity" asp-page="/Account/Register">Register</a>
                    </div>
                }
            </div>
        </aside>

        <!-- Main area -->
        <div class="vr-main">
            <!-- Topbar -->
            <header class="vr-topbar">
                <div class="vr-topbar-left">
                    <button class="vr-sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('open');document.getElementById('sidebarBackdrop').classList.toggle('show');" aria-label="Toggle sidebar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <nav class="vr-breadcrumb" aria-label="Breadcrumb">
                        <a asp-area="" asp-page="/Files/Index">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                        </a>
                        @if (ViewData["Title"] != null)
                        {
                            <span class="separator">/</span>
                            <span>@ViewData["Title"]</span>
                        }
                    </nav>
                </div>
                <div class="vr-topbar-right">
                    @if (isAuth)
                    {
                        <div class="vr-topbar-status">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--vr-success)" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            <span>Encrypted</span>
                        </div>
                    }
                </div>
            </header>

            <!-- Page content -->
            <div class="vr-content">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

            <footer class="vr-footer">
                &copy; 2025 VaultRoom &mdash; <a asp-area="" asp-page="/Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>