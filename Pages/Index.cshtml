                    <td><span class="cross">Common</span></td>
                    <td><span class="cross">Some</span></td>
                    <td>Possible</td>
                </tr>
                <tr>
                    <td>AES-256 encryption</td>
                    <td class="highlight"><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                </tr>
                <tr>
                    <td>Dynamic watermarks</td>
                    <td class="highlight"><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="cross">✗</span></td>
                </tr>
                <tr>
                    <td>Large file upload (100 GB+)</td>
                    <td class="highlight"><span class="check">✓</span></td>
                    <td>Limited</td>
                    <td>Limited</td>
                    <td>Limited</td>
                    <td><span class="cross">✗</span></td>
                </tr>
                <tr>
                    <td>Multi-tenant isolation</td>
                    <td class="highlight"><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="cross">✗</span></td>
                </tr>
                <tr>
                    <td>Immutable audit ledger</td>
                    <td class="highlight"><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td><span class="check">✓</span></td>
                    <td>Basic</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<!-- ============= FEATURES (summary) ============= -->
<section class="vr-features">
    <div class="vr-feature-card">
        <div class="icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3>Isolated Deal Rooms</h3>
        <p>Every deal gets its own room with separate folders, files, and access — fully isolated from other projects.</p>
    </div>
    <div class="vr-feature-card">
        <div class="icon">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <h3>Watermarked Viewing</h3>
        <p>View PDFs, DOCX, and XLSX inline. Dynamic watermarks trace every page view to a specific user.</p>
    </div>
    <div class="vr-feature-card">
        <div class="icon">
            <svg viewBox="0 0 24 24"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
        </div>
        <h3>100 GB File Upload</h3>
        <p>Parallel block transfers to Azure Blob. Progress tracking, MD5 integrity verification, and cancellation support.</p>
    </div>
    <div class="vr-feature-card">
        <div class="icon">
            <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3>Nested Folders</h3>
        <p>Organize with unlimited folder depth. Recursive operations make bulk management fast.</p>
    </div>
    <div class="vr-feature-card">
        <div class="icon">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Multi-Tenant</h3>
        <p>Subdomain-based tenant isolation. Each org gets independent data, users, and configuration.</p>
    </div>
    <div class="vr-feature-card">
        <div class="icon">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3>Audit &amp; Compliance</h3>
        <p>Immutable SQL audit ledger. Every action logged with timestamps, user IDs, and tenant context.</p>
    </div>
</section>

<!-- ============= CTA BANNER ============= -->
<div class="vr-cta-banner">
    <h2>Ready to close faster?</h2>
    <p>Create your first secure room in under 2 minutes. No credit card required.</p>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn-cta">Start Free →</a>
</div>

<!-- ============= FOOTER ============= -->
<footer class="vr-landing-footer">
    <div class="footer-links">
        <a asp-page="/Features">Features</a>
        <a asp-page="/Pricing">Pricing</a>
        <a asp-page="/Security">Security</a>
        <a asp-page="/UseCases">Use Cases</a>
        <a asp-page="/Privacy">Privacy</a>
    </div>
    &copy; 2025 VaultRoom. All rights reserved.
</footer>
