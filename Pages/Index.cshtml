@page
@model IndexModel
@{
    ViewData["Title"] = "Secure Document Sharing";
    Layout = "_Layout.Landing";
}

<!-- Navigation -->
<nav class="vr-landing-nav">
    <a class="brand" href="/">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
        VaultRoom
    </a>
    <div class="nav-links">
        <a asp-page="/Features">Features</a>
        <a asp-page="/Pricing">Pricing</a>
        <a asp-page="/Security">Security</a>
        <a asp-page="/UseCases">Use Cases</a>
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a asp-area="" asp-page="/Files/Index" class="btn-landing-primary" style="padding:.45rem 1.2rem;font-size:.85rem;">Dashboard</a>
        }
        else
        {
            <a href="#" onclick="openLoginModal();return false;">Sign in</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-landing-primary" style="padding:.45rem 1.2rem;font-size:.85rem;">Start Free</a>
        }
    </div>
</nav>

<!-- ===================== HERO ===================== -->
<section class="vr-hero">
    <h1>The virtual data room<br />that doesn't waste your time</h1>
    <p>
        Set up a secure deal room in under 2 minutes — no sales calls, no per-page fees,
        no 30-page contracts. Enterprise-grade security at a flat monthly rate.
    </p>
    <div class="cta-group">
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a asp-area="" asp-page="/Files/Index" class="btn-landing-primary">Open Dashboard</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-landing-primary">Create Your Room — Free</a>
            <a asp-page="/Pricing" class="btn-landing-secondary">See Pricing</a>
        }
    </div>
</section>

<!-- ================ TRUST STRIP ================ -->
<section class="vr-trust">
    <p>Enterprise-grade security, startup-friendly pricing</p>
    <div class="stats">
        <div class="stat"><strong>AES-256</strong><span>Encryption at rest</span></div>
        <div class="stat"><strong>TLS 1.3</strong><span>In transit</span></div>
        <div class="stat"><strong>MFA</strong><span>Multi-factor auth</span></div>
        <div class="stat"><strong>&lt; 2 min</strong><span>Onboarding time</span></div>
        <div class="stat"><strong>$0</strong><span>Hidden fees</span></div>
    </div>
</section>

<!-- ============= PAIN POINTS (Competitor problems) ============= -->
<section class="vr-section" style="background:var(--vr-bg);">
    <div class="vr-section-header">
        <span class="eyebrow">Why Switch</span>
        <h2>Legacy data rooms weren't built for you</h2>
        <p>Intralinks, Datasite, Firmex, and DocSend charge you more for doing less. Here's what we fix.</p>
    </div>
    <div class="vr-pain-grid">
        <div class="vr-pain-card">
            <div class="pain-icon red">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <h4>Slow, sales-gated onboarding</h4>
            <p>Most VDR vendors force you through demo calls, procurement, and multi-week setup. VaultRoom is self-serve — create an account and upload your first file in under 2 minutes.</p>
        </div>
        <div class="vr-pain-card">
            <div class="pain-icon amber">
                <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h4>Per-page and per-user fees</h4>
            <p>Legacy platforms charge per page uploaded, per user invited, or per GB stored — costs spiral during a deal. VaultRoom uses flat-rate pricing with no surprises.</p>
        </div>
        <div class="vr-pain-card">
            <div class="pain-icon purple">
                <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h4>Hidden fees everywhere</h4>
            <p>Overage charges, setup fees, "premium" security add-ons, archive fees. Our price is the price — no footnotes, no surcharges, no gotchas.</p>
        </div>
        <div class="vr-pain-card">
            <div class="pain-icon gray">
                <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h4>Steep learning curves</h4>
            <p>Complex admin panels, clunky permission UIs, and 50-page user guides. VaultRoom has one clean interface — if you've used Dropbox, you can use VaultRoom.</p>
        </div>
    </div>
</section>

